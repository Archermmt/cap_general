classDiagram
    class RegisteredBase {
      +register()
      +from_config(config)
      +create(type)
    }

    class BaseScene {
      +from_yaml(config)
      +serve(transport)
      +reset(agent_options)
      +agent_doc(agents)
      +execute(agent_codes)
      +monitor(agents)
      +retry(agents)
      +record(agents)
      +update_history(agent_messages)
    }

    class AgentInfo {
      +agent
      +status
      +task
    }

    class BaseAgent {
      +reset(options)
      +agent_doc()
      +execute(code)
      +retry()
      +run_pipe(job_options, policy_name)
      +record()
      +get_obs()
      +functions()
    }

    class BaseRobot {
      +reset(options)
      +step(action)
      +get_observation(folder)
      +record(folder)
      +train()
      +eval()
    }

    class BasePolicy {
      +reset()
      +run(stage, inputs)
      +visualize(record_dir)
      +train()
      +eval()
    }

    class CapGraph {
      +add_node(name, node_type, inputs)
      +nodes()
      +from_dict(data)
      +to_dict()
    }

    class CapNode {
      +op_group
      +op_type
      +inputs
      +parents
      +children
      +output(idx)
    }

    class CapData {
      +values
      +set(key, value)
      +update(data)
    }

    class BaseOperator {
      +register()
      +create(op_group, op_type)
      +set_stage(stage)
      +run(inputs)
    }

    class BasePipeline {
      +execute(jobs, policy, robot, options)
      +options_doc()
    }

    class BaseJob {
      +execute(policy, robot, options)
    }

    class TrainJob
    class GenesisScene
    class GenesisBaseAgent
    class GenesisFrankaAgent
    class GenesisFrankaRobot

    RegisteredBase <|-- BaseScene
    RegisteredBase <|-- BaseAgent
    RegisteredBase <|-- BaseRobot
    RegisteredBase <|-- BasePolicy
    RegisteredBase <|-- BasePipeline

    BaseScene "1" o-- "*" AgentInfo
    AgentInfo "1" o-- "1" BaseAgent
    BaseAgent "1" *-- "1" BaseRobot
    BaseAgent "1" *-- "*" BasePolicy
    BaseAgent "0..1" o-- "1" BasePipeline

    BasePolicy "1" *-- "1" CapGraph
    CapGraph "1" *-- "*" CapNode
    CapNode "1" *-- "*" CapData
    BasePolicy ..> BaseOperator : create by node type

    BasePipeline "1" *-- "*" BaseJob
    BasePipeline ..> BasePolicy : transforms/rebuilds
    BasePipeline ..> BaseRobot : train/eval target
    BaseJob <|-- TrainJob

    BaseScene <|-- GenesisScene
    BaseAgent <|-- GenesisBaseAgent
    GenesisBaseAgent <|-- GenesisFrankaAgent
    BaseRobot <|-- GenesisFrankaRobot
