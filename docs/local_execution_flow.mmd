sequenceDiagram
    participant UT as unit test / client
    participant Scene as BaseScene
    participant Agent as BaseAgent
    participant Robot as BaseRobot
    participant Policy as BasePolicy
    participant Operator as BaseOperator
    participant Code as exec(code)

    UT->>Scene: BaseScene.from_config/from_yaml(config)
    Scene->>Agent: BaseAgent.from_config(agent spec)
    Agent->>Robot: BaseRobot.from_config(robot spec)
    opt policies configured
        Agent->>Policy: BasePolicy.from_config(policy spec)
        Policy->>Policy: reset() builds CapGraph
        Policy->>Operator: BaseOperator.create(node op_group/op_type)
    end
    Scene->>Agent: post_build(scene)
    Agent->>Robot: post_build(scene)
    opt policies configured
        Agent->>Policy: reset()/visualize()
    end

    UT->>Scene: reset({agent_name: options})
    Scene->>Agent: reset(options)
    Agent->>Robot: reset(options)

    UT->>Scene: agent_doc([agent_name])
    Scene->>Agent: agent_doc()
    Agent-->>UT: function_doc / policy_doc / execute_rules / max_retry

    UT->>Scene: execute({agent_name: code})
    Scene->>Scene: _start_task(agent_name, "execute")
    Scene->>Agent: execute(code)
    Agent->>Agent: _execute_once(code)
    Agent->>Code: exec with globals robot + functions()
    opt generated code calls robot directly
        Code->>Robot: step(action) / robot method
    end
    opt generated code calls policy helper
        Code->>Agent: exposed function
        Agent->>Policy: run(stage, inputs)
        Policy->>Operator: run(inputs)
        Operator-->>Policy: output
        Policy-->>Agent: PolicyResult
    end
    Agent->>Robot: get_observation(step_dir)
    Agent-->>Scene: status/result/obs/stdout/stderr
    Scene-->>UT: keyed by agent mark

    opt async_task=true
      UT->>Scene: monitor([agent_name])
      Scene-->>UT: final status
    end

    UT->>Scene: record([agent_name])
    Scene->>Agent: record()
    Agent->>Robot: record(...)
